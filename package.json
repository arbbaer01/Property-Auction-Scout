{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"const fs = require('fs'); ['package-lock.json', 'yarn.lock'].forEach(f => fs.existsSync(f) && fs.unlinkSync(f));\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.68.5",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.5",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
